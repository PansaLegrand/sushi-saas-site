{
  "name": "sushi-saas-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": "10.22.0"
  },
  "scripts": {
    "dev": "fumadocs-mdx && next dev --turbopack",
    "dev:webpack": "fumadocs-mdx && next dev",
    "content:check": "node scripts/check-content.mjs",
    "content:check:starter": "node scripts/check-starter-sync.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "pnpm content:check && fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "check": "pnpm content:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "fumadocs-core": "15.8.0",
    "fumadocs-mdx": "11.10.1",
    "fumadocs-ui": "15.8.0",
    "lucide-react": "^0.439.0",
    "next": "15.5.22",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2"
  }
}
